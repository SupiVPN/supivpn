{
  "logging": {"output": "stderr"},
  "public_url": "https://vpn.example.test:9443",
  "listen": "127.0.0.1:9443",
  "tls_certificate": "/etc/supivpn/tls/crt.pem",
  "tls_chain": "/etc/supivpn/tls/chain.pem",
  "tls_private_key": "/etc/supivpn/tls/key.pem",
  "idp_metadata": "/etc/supivpn/idp-metadata.xml",
  "management_socket": "/run/supivpn-node/management.sock",
  "pending_seconds": 180,
  "session_seconds": 43200,
  "max_connections_per_user": 1,
  "saml_groups_attribute": "groups",
  "vpn_network": "10.203.0.0/24",
  "group_pools": [
    {"group_name": "admins-vpn", "priority": 10, "max_connections_per_user": 2, "cidr": "10.203.0.0/26"},
    {"group_name": "engineers-production-vpn", "priority": 20, "session_seconds": 3600, "cidr": "10.203.0.64/26"}
  ],
  "remote_controller": {
    "transport": "unix",
    "agent_socket": "/run/supivpn-controller/agent.sock",
    "controller_uid": 1001,
    "public_url": "https://login.example.test",
    "node_id": "node-a",
    "state_directory": "/var/lib/supivpn-node"
  },
  "profile_binding": "required"
}
