{
  "logging": {
    "output": "file",
    "file": "/var/log/supivpn/controller.jsonl",
    "retention_days": 7,
    "max_size_mb": 10,
    "max_files": 10
  },
  "public_url": "https://login.example.test",
  "database_tls": {"mode": "require"},
  "idp_metadata": "/etc/supivpn/idp-metadata.xml",
  "saml_groups_attribute": "groups",
  "groups": [
    {
      "name": "admins-vpn",
      "priority": 10,
      "max_connections_per_user": 2
    },
    {
      "name": "engineers-production-vpn",
      "priority": 20,
      "session_seconds": 3600
    }
  ],
  "pending_seconds": 180,
  "session_seconds": 43200,
  "max_connections_per_user": 1,
  "profile": {
    "endpoint": "vpn.example.test",
    "template_file": "/etc/supivpn/client.ovpn.template",
    "server_key_file": "/var/lib/supivpn/tls-crypt-v2-server.key"
  },
  "vm": {
    "listen": ":8443",
    "tls_certificate": "/etc/supivpn/tls/crt.pem",
    "tls_chain": "/etc/supivpn/tls/chain.pem",
    "tls_private_key": "/etc/supivpn/tls/key.pem",
    "agent_socket": "/run/supivpn-controller/agent.sock",
    "agent_uid": 0,
    "node_id": "node-a"
  }
}
