set -eu
# --no-start also suppresses debhelper's stop snippet. Stop only on removal.
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    deb-systemd-invoke stop supivpn-node.service supivpn-openvpn.service
fi
#DEBHELPER#
