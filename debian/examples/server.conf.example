# Tested OpenVPN Community 2.7.8; foreground service managed by systemd.
port 1194
proto udp4
dev supivpn0
dev-type tun
topology subnet
server 10.203.0.0 255.255.255.0 nopool
max-clients 16
max-routes-per-client 1
script-security 2
learn-address "/usr/sbin/supivpn -learn-address"
cert /etc/supivpn/node/crt.pem
extra-certs /etc/supivpn/node/chain.pem
key /etc/supivpn/node/key.pem
tls-crypt-v2 /etc/supivpn/keys/tls-crypt-v2-server.key
tls-crypt-v2-verify "/usr/sbin/supivpn -verify-profile-metadata required"
ca /etc/ssl/certs/ca-certificates.crt
dh none
tls-version-min 1.2
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
allow-compression no
disable-dco
verify-client-cert none
auth-user-pass-optional
duplicate-cn
management /run/supivpn/management.sock unix
management-client
management-client-auth
management-hold
hand-window 180
reneg-sec 600 600
keepalive 10 60
persist-key
persist-tun
# Routing, DNS and forwarding must be configured for the deployment separately.
verb 2
