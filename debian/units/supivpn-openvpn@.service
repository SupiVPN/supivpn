[Unit]
Description=OpenVPN for the SupiVPN node
BindsTo=supivpn-node@%i.service
PartOf=supivpn-node@%i.service
After=supivpn-node@%i.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/usr/sbin/openvpn --config /etc/supivpn/nodes/%i/openvpn.conf
Restart=no
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
StandardOutput=journal
StandardError=journal
